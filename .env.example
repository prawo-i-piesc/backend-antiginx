# Backend Port
BACKEND_PORT=

# Database URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@localhost:1234/postgres"

# RabbitMQ URL
RABBITMQ_URL=

# JWT Secret Key
JWT_SECRET=

PUBLIC_BASE_URL=

COOKIE_SECURE=

# Reverse proxies allowed to set X-Forwarded-For, comma separated IPs or CIDRs.
# Empty means the connection address is used as the client IP.
TRUSTED_PROXIES=

# gin runtime mode: release on deployments, debug locally
GIN_MODE=release

ACCESS_TOKEN_TTL=1h

REFRESH_TOKEN_TTL=

TOTP_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=

GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=

GITHUB_CLIENT_SECRET=

WEBAUTHN_RPID=

WEBAUTHN_RP_NAME=

MAIL_TRANSPORT=

MAIL_FROM=

RESEND_API_KEY=
