# Backend Port
BACKEND_PORT=

# Database URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@localhost:1234/postgres"

# RabbitMQ URL
RABBITMQ_URL=

# JWT Secret Key
JWT_SECRET=

# Frontend origin (np. https://antiginx.pl, lokalnie http://localhost:3000)
PUBLIC_BASE_URL=

# Secure na cookie sesji (default: true)
COOKIE_SECURE=

# Access token TTL (default: 15m)
ACCESS_TOKEN_TTL=1h

# Refresh token TTL (default: 720h)
REFRESH_TOKEN_TTL=

# Klucz szyfrujacy sekrety TOTP: 32 bajty base64
# openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
